# Collaboration server — per-install configuration.
#
# Copy to `.env` (gitignored) and fill for THIS machine.
COLLAB_PORT=7312
COLLAB_HOST=127.0.0.1
COLLAB_ORIGINS=http://localhost:7311,http://127.0.0.1:7311
# Access (feature-0004). COLLAB_MEMBERS points at the registry; absent means
# no members and every room public.
COLLAB_MEMBERS=
COLLAB_ACCESS_LOG=
COLLAB_ENFORCE_ACCESS=on
