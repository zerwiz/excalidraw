# VITE_DEBUG_DOM
#   When "true", testing-library failures (waitFor / getBy*) include the full
#   serialized DOM in the error message. It's off by default because it's noisy.
#
#   Flip it to "true" (or use `VITE_DEBUG_DOM=true yarn test`) when you need to
#   inspect the DOM of a failing test.
VITE_DEBUG_DOM=false

# ─────────────────────────────────────────────────────────────────────────────
# Test-only endpoints.
#
# The shipped defaults are EMPTY (see .env.development / .env.production) so the
# app contacts no hosted service. The collaboration tests exercise a *configured*
# room server — `socket.io-client` is mocked in excalidraw-app/tests/collab.test.tsx,
# so nothing leaves the process.
# ─────────────────────────────────────────────────────────────────────────────
VITE_APP_WS_SERVER_URL=http://localhost:7312
