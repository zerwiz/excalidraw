MODE="production"

# ─────────────────────────────────────────────────────────────────────────────
# Every endpoint below is EMPTY ON PURPOSE.
#
# This fork contacts no Excalidraw-controlled or third-party host by default.
# A production build that sets none of these is a fully local app: it draws,
# saves and exports, and opens no socket. See tickets/open/feature-0001-*.
#
# Supply these at build time (CI env, or .env.production.local) to enable a
# feature. Never commit a real DSN, key or project id.
# ─────────────────────────────────────────────────────────────────────────────

# Scene sharing (share links): a read URL and a write URL, both required.
VITE_APP_BACKEND_V2_GET_URL=
VITE_APP_BACKEND_V2_POST_URL=

# The community library: browsing (URL) and publishing (backend) are separate.
VITE_APP_LIBRARY_URL=
VITE_APP_LIBRARY_BACKEND=

# Collaboration WebSocket server.
VITE_APP_WS_SERVER_URL=

# AI text-to-diagram backend.
VITE_APP_AI_BACKEND=

# Error reporting. Unset = Sentry is never initialised.
VITE_APP_SENTRY_DSN=

# Firebase config for inherited scene/file storage. Unset = that storage is inert.
VITE_APP_FIREBASE_CONFIG=

# Telemetry is OFF unless explicitly set to "true".
VITE_APP_ENABLE_TRACKING=false

# Set the below flags explicitly to false in production mode since vite loads and merges .env.local vars when  running the build command
VITE_APP_DEBUG_ENABLE_TEXT_CONTAINER_BOUNDING_BOX=false
VITE_APP_COLLAPSE_OVERLAY=false
# Enable eslint in dev server
VITE_APP_ENABLE_ESLINT=false
