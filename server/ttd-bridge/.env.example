# TTD bridge — per-install configuration.
#
# Copy to `.env` (gitignored) and fill for THIS machine. Nothing here ships with
# a value, so two installs point at two different models without a code change.
TTD_MODEL_BASE_URL=http://127.0.0.1:8080/v1
TTD_MODEL=
TTD_MODEL_API_KEY=
TTD_BRIDGE_PORT=7313
TTD_BRIDGE_HOST=127.0.0.1
TTD_BRIDGE_ORIGINS=http://localhost:7311,http://127.0.0.1:7311
